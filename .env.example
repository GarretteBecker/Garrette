# Copy this file to .env.local and fill in the values.
#
# ---------------------------------------------------------------------
# Supabase — REQUIRED
# ---------------------------------------------------------------------
# From your Supabase project: Dashboard → Project Settings → Data API.
#
# Both are safe to expose in the browser. The anon key grants no access on
# its own — every table is protected by Row Level Security, so a signed-out
# holder of this key can read nothing.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# ---------------------------------------------------------------------
# Data-plate scanning — OPTIONAL
# ---------------------------------------------------------------------
# Powers "Scan data plate": point the camera at a placard and it reads the
# make, model and serial off it.
#
# Leave this blank and everything else still works — the camera still
# captures and stores photos, you just type the numbers in by hand.
#
# Get a key at https://console.anthropic.com → API Keys.
# This is a SERVER-side secret. It is never sent to the browser (note there
# is no NEXT_PUBLIC_ prefix). Never commit it, never paste it in a chat.
#
# Cost: each scan is one API call on a compressed photo — a fraction of a
# cent. A busy visit with a dozen scans is still well under five cents.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# GoHighLevel — OPTIONAL
# ---------------------------------------------------------------------
# HomeKeeper posts an event to GHL when a report is released, a service
# request changes stage, or a visit is scheduled. A GHL workflow then
# decides what to text or email the member.
#
# Get the URL from a GHL workflow's "Inbound Webhook" trigger — full
# walkthrough in docs/gohighlevel.md.
#
# Leave blank and the integration is simply off. Nothing is sent, nothing
# breaks. A failed send never blocks the work it describes.
#
# GHL_WEBHOOK_SECRET is a random string you invent. HomeKeeper sends it as
# a header so your workflow can confirm the post really came from here.

GHL_WEBHOOK_URL=
GHL_WEBHOOK_SECRET=

# Optional: a separate GHL workflow per event. Set any of these and that
# event goes to its own workflow instead of the shared one above; leave them
# blank and everything goes to GHL_WEBHOOK_URL and you branch inside GHL.
GHL_WEBHOOK_URL_REPORT_RELEASED=
GHL_WEBHOOK_URL_REQUEST_STAGE=
GHL_WEBHOOK_URL_VISIT_SCHEDULED=

# Compliance. The renewal notice carries the disclosure already written, in
# member_message. The rescinded event should point at the OFFICE, not the
# member — it fires when somebody cancels inside their three-business-day
# window, and that is news you want today.
GHL_WEBHOOK_URL_RENEWAL_NOTICE=
GHL_WEBHOOK_URL_MEMBERSHIP_RESCINDED=

# Warranty watch. member_message arrives already written — it is the one
# event that puts money back in a member's pocket, so it earns its own
# workflow and its own template.
GHL_WEBHOOK_URL_WARRANTY_EXPIRING=

# ---------------------------------------------------------------------
# Emergency numbers, for "I need help now"
#
# ⚠ There are NO defaults here, on purpose. A wrong number on a gas-leak
# screen is the worst bug this app could have, so an unset contact simply
# does not render and the screen tells the member to look at their bill.
# Check each one against a real bill for your area before you set it.
#
# NEXT_PUBLIC_ because an emergency number is meant to be read by the
# person holding the phone. Until BM_EMERGENCY_PHONE is set there is no
# "Call B&M" button at all — setting it is the single highest-value thing
# you can do to that feature.
# ---------------------------------------------------------------------
NEXT_PUBLIC_BM_EMERGENCY_PHONE=
NEXT_PUBLIC_GAS_UTILITY_NAME=
NEXT_PUBLIC_GAS_UTILITY_PHONE=
NEXT_PUBLIC_ELECTRIC_UTILITY_NAME=
NEXT_PUBLIC_ELECTRIC_UTILITY_PHONE=
NEXT_PUBLIC_WATER_UTILITY_NAME=
NEXT_PUBLIC_WATER_UTILITY_PHONE=
