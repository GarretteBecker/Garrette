# Copy this file to .env.local and fill in the values.
#
# ---------------------------------------------------------------------
# Supabase — REQUIRED
# ---------------------------------------------------------------------
# From your Supabase project: Dashboard → Project Settings → Data API.
#
# Both are safe to expose in the browser. The anon key grants no access on
# its own — every table is protected by Row Level Security, so a signed-out
# holder of this key can read nothing.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# ---------------------------------------------------------------------
# Data-plate scanning — OPTIONAL
# ---------------------------------------------------------------------
# Powers "Scan data plate": point the camera at a placard and it reads the
# make, model and serial off it.
#
# Leave this blank and everything else still works — the camera still
# captures and stores photos, you just type the numbers in by hand.
#
# Get a key at https://console.anthropic.com → API Keys.
# This is a SERVER-side secret. It is never sent to the browser (note there
# is no NEXT_PUBLIC_ prefix). Never commit it, never paste it in a chat.
#
# Cost: each scan is one API call on a compressed photo — a fraction of a
# cent. A busy visit with a dozen scans is still well under five cents.

ANTHROPIC_API_KEY=
